# Reference only: TaskFlow reads real environment variables (it does not load .env files).
# Set these in your shell, or in Render -> Environment.

# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Where the SQLite database lives. On Render with a persistent disk: /var/data/taskflow.db
# DB_PATH=instance/taskflow.db

# PORT=5000

# Trust X-Forwarded-For from a reverse proxy for rate limiting (automatic on Render)
# TRUST_PROXY=1

# Force Secure cookies when serving over HTTPS (automatic on Render)
# COOKIE_SECURE=1

# Optional AI model for the agents. Without a key, built-in rules are used.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_PROVIDER=anthropic        # or openai
# AI_MODEL=claude-sonnet-5-5   # or e.g. gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
